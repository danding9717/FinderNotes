+    }
+
+    private func eventually(_ condition: () -> Bool, file: StaticString = #filePath,
+                            line: UInt = #line) async throws {
+        for _ in 0..<500 {
+            if condition() { return }
+            try await Task.sleep(for: .milliseconds(10))
+        }
+        XCTFail("Controller condition did not settle", file: file, line: line)
